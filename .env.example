# Configure one or more Macha APIs directly; blank/same-origin endpoints are ignored.
VITE_MACHA_SERVER=http://127.0.0.1:7438
# VITE_MACHA_SERVERS=http://10.44.1.50:7438,http://10.44.1.51:7438

# Use the built-in local demo instead of a server.
# VITE_DEMO=true

# Macha supports browser CORS, so the client needs no Vite API proxy:
# VITE_MACHA_SERVER=http://macha-node.local:7438
