# Same-origin is the default. For Vite development, proxy /api to a Macha node:
MACHA_API_TARGET=http://127.0.0.1:7438

# Use the built-in local demo instead of a server.
# VITE_DEMO=true

# If you deliberately expose the API cross-origin (requires CORS on that endpoint):
# VITE_MACHA_SERVER=http://macha-node.local:7438
