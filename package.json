{
  "name": "macha-client",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build-samsung": "tsc -b && vite build --mode samsung",
    "install-samsung": "bash install-samsung.sh",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "hls.js": "1.6.18",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "@vitejs/plugin-legacy": "^7.2.1",
    "terser": "^5.16.0"
  },
  "license": "GPL-3.0-or-later",
  "description": "Small React/TypeScript web and TV client for Macha.",
  "engines": {
    "node": ">=20"
  }
}
